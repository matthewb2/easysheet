{
  "name": "Easysheet",
  "version": "1.0.0",
  "description": "EasySheet Desktop Application",
  "main": "build/main.js",
  "scripts": {
    "start": "electron .",
    "build": "webpack --mode production && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3"
  }, 
  "build": {
    "appId": "com.app.easysheet",
    "productName": "EasySheet",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "files": [
      "build/main.js",
      "electron/preload.js",
      "index.html",
      "src/io.js",
      "vendor/luckysheet/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
